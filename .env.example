# claude-mv — per-machine config
#
# Copy this file to `.env` beside claude-mv.zsh and adjust. The .env is
# gitignored.
#
# Sourcing convention: claude-mv sources this file *inside* its own function
# scope and declares every key `local` first, so `typeset` (without -g) keeps
# the values function-local — nothing leaks into the interactive shell.

# Claude Code profile dirs whose history claude-mv migrates on a move.
# Default when unset: ~/.claude, plus ~/.claude-personal when it exists —
# only set this if that auto-detection is wrong for this machine.
#typeset -a CLAUDE_PROFILE_DIRS=("$HOME/.claude" "$HOME/.claude-personal")

# Keep the restore point after a successful overwrite, as the archive of the
# discarded destination history. Default: 1 (kept). Set 0 to opt out —
# overwrite then cleans up its restore point like the other modes do.
#typeset CLAUDE_MV_OVERWRITE_BACKUP=1

# Where restore points live. Default: ~/.claude-mv/restore
#typeset CLAUDE_MV_RESTORE_ROOT="$HOME/.claude-mv/restore"
